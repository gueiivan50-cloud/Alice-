# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Cle API OpenAI pour l'agent commercial IA et le Centre de Controle IA.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Securite Administration (si vide, configuration au premier demarrage via l'interface Admin)
ADMIN_PASSCODE=

# Prestataire de paiement compatible Cote d'Ivoire (CinetPay XOF : Wave, Orange Money, MTN, Moov, Carte)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# Configuration Supabase & Netlify (pour deploiement externe)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
